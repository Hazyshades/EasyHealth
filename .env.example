# Skip validation during build (set to 1 in CI)
# SKIP_ENV_VALIDATION=1

# App URL
URL=http://localhost:3000

# EH-151 scoped share capability (required for public-share deployment)
# Keep at most the current key and one previous rotation key in the ring.
# SHARE_TOKEN_KEY_RING={"2026-1":"replace-with-a-secret-at-least-16-characters","2025-1":"previous-secret-at-least-16-characters"}
# SHARE_TOKEN_CURRENT_KEY_VERSION=2026-1
# SHARE_PIN_PROOF_PEPPER=replace-with-a-secret-at-least-16-characters
# SHARE_RATE_LIMIT_PEPPER=replace-with-a-secret-at-least-16-characters
# SHARE_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# SHARE_TRUSTED_PROXY_ATTESTATION_KEY=replace-with-a-secret-at-least-16-characters
# SHARE_TRUSTED_PROXY_ATTESTATION_MAX_AGE_SECONDS=30
# SHARE_PIN_PROOF_TTL_SECONDS=900
# SHARE_RATE_LIMIT_WINDOW_SECONDS=60
# SHARE_RATE_LIMIT_TOKEN_FAILURES=10
# SHARE_RATE_LIMIT_REQUESTER_FAILURES=30
# SHARE_ACCESS_EVENT_RETENTION_DAYS=30
# SHARE_ACCESS_EVENT_CLEANUP_INTERVAL_MS=3600000
# SHARE_ACCESS_EVENT_CLEANUP_RETRY_INTERVAL_MS=60000
# SHARE_RATE_LIMIT_CLEANUP_INTERVAL_MS=900000
# SHARE_RATE_LIMIT_CLEANUP_RETRY_INTERVAL_MS=60000

# Supabase - https://supabase.com/dashboard/project/_/settings/api
# Auth: enable Google + Email magic link; redirect = {URL}/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI extraction & summaries (OpenAI = ChatGPT default)
OPENAI_API_KEY=your-openai-api-key

# Optional: enable DeepSeek as a user-selectable provider in AI Settings
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Optional: Tencent Hy3 (free) via OpenRouter (https://openrouter.ai/tencent/hy3:free)
OWL_ALPHA_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OWL_ALPHA_MODEL=tencent/hy3:free

# Optional Nebius
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Document worker (optional — required for async upload processing)
# WORKER_POLL_INTERVAL_MS=5000
# NEXT_PUBLIC_TERMS_URL=
# NEXT_PUBLIC_PRIVACY_URL=
# NEXT_PUBLIC_COOKIE_POLICY_URL=

# Optional Mistral OCR for scanned PDFs/images (worker-only; separate from AI provider)
# MISTRAL_API_KEY=
# MISTRAL_OCR_ENABLED=false
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_OCR_REGION=eu
# MISTRAL_OCR_TIMEOUT_MS=45000
# MISTRAL_OCR_MAX_BYTES=26214400
# MISTRAL_OCR_MAX_PAGES=100
# MISTRAL_OCR_FAILURE_MODE=fail
