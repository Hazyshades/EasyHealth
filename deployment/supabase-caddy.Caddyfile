supabase.217-216-86-38.sslip.io {
        encode zstd gzip

        reverse_proxy easyhealth-supabase:8000

        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains"
                X-Content-Type-Options "nosniff"
                -Server
        }

        log {
                output stdout
                format console
        }
}
